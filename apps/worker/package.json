{
  "name": "@alinstra/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "lint": "pnpm -w exec eslint apps/worker/src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@alinstra/config": "workspace:*",
    "@alinstra/crypto": "workspace:*",
    "@alinstra/db": "workspace:*",
    "@alinstra/email": "workspace:*",
    "@alinstra/queue": "workspace:*",
    "@alinstra/storage": "workspace:*",
    "@sentry/node": "10.22.0",
    "bullmq": "6.3.10",
    "tsx": "4.20.6"
  },
  "devDependencies": {
    "@alinstra/tsconfig": "workspace:*",
    "@types/node": "22.19.1",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
