# Copy to `.env` for local development. Never commit `.env`.

NODE_ENV=development

# App
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32  (at least 32 characters)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# 32-byte key for app-owned secrets (invite token ciphertext; later OAuth tokens).
# Better Auth already encrypts TOTP secrets with BETTER_AUTH_SECRET — see docs/DECISIONS.md.
# Generate: openssl rand -base64 32
#        or node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=change-me-generate-a-32-byte-base64-key

# Bootstrap admin (seed) — never hardcode the address in source.
# ADMIN_INITIAL_PASSWORD is used only by `pnpm db:seed` when the user does not exist yet.
ADMIN_EMAIL=you@example.com
ADMIN_INITIAL_PASSWORD=change-me-min-12-chars

# Postgres (matches docker-compose.yml). Tests never use this database.
DATABASE_URL=postgresql://alinstra:alinstra@localhost:5432/alinstra?schema=public
# Optional. When unset, tests use the same URL with the database name ending in _test
# (alinstra becomes alinstra_test) and create that database if it is missing.
# DATABASE_URL_TEST=postgresql://alinstra:alinstra@localhost:5432/alinstra_test?schema=public

# Redis (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Email (Resend in staging/production; console transport in local/dev)
RESEND_API_KEY=
EMAIL_FROM=notifications@alinstra.com
EMAIL_TRANSPORT=console

# Observability (optional locally). Leave SENTRY_DSN empty to disable sending.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
# Browser errors only. The DSN is public; PII is still stripped.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local

# Tests set LOCKOUT_STORE=memory so login lockout does not need Redis.
# LOCKOUT_STORE=memory

# Rightmost X-Forwarded-For entries written by our proxy. Default 1.
# Railway's documented client IP is X-Real-IP, which wins when present.
# TRUSTED_PROXY_HOPS=1

# Knowledge files. local in development; s3 (Cloudflare R2) in production.
# The bucket stays private. Downloads go through the app.
STORAGE_DRIVER=local
UPLOAD_DIR=.data/uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
