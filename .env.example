# Copy to `.env` for local development. Never commit `.env`.
# Full Phase 0 variable set is documented here; values below are local defaults.

NODE_ENV=development

# App
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Bootstrap admin (seed) — never hardcode this address in source
ADMIN_EMAIL=you@example.com

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://alinstra:alinstra@localhost:5432/alinstra?schema=public

# Redis (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Email (Resend in staging/production; console transport in local/dev)
RESEND_API_KEY=
EMAIL_FROM=notifications@alinstra.com
EMAIL_TRANSPORT=console

# Observability (optional locally)
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
