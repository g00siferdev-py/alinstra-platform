generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Better Auth user. `clientId` is null for admin.
model User {
  id               String      @id
  name             String
  email            String
  emailVerified    Boolean     @default(false)
  image            String?
  role             String
  clientId         String?
  twoFactorEnabled Boolean?    @default(false)
  /// Staff only: whether this user may open calls, transcripts, and recordings. Owners and admins always can.
  canViewCalls     Boolean     @default(false)
  /// Self-serve signup terms acceptance (Phase B). Null for invited/admin-created users.
  termsAcceptedAt  DateTime?
  termsVersion     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  client           Client?     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sessions         Session[]
  accounts         Account[]
  twoFactor        TwoFactor?

  @@unique([email])
  @@index([clientId])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// TOTP secret and backup codes are ciphertext produced by Better Auth (see DECISIONS.md).
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@map("twoFactor")
}

model Plan {
  id                      String   @id @default(cuid())
  code                    String   @unique
  name                    String
  monthlyPriceCents       Int
  includedMinutes         Int
  overagePerMinuteCents   Int
  setupFeeCents           Int
  includedChangesPerMonth Int?
  extraChangeFeeCents     Int
  recallMonthlyCents      Int
  recallPerBookingCents   Int
  active                  Boolean  @default(true)
  sortOrder               Int
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  clients                 Client[]

  @@map("plan")
}

model Client {
  id                              String    @id @default(cuid())
  name                            String
  industry                        String?
  contactName                     String?
  contactPhone                    String?
  contactEmail                    String?
  addressLine1                    String?
  addressLine2                    String?
  city                            String?
  region                          String?
  postalCode                      String?
  country                         String?
  timezone                        String    @default("America/New_York")
  websiteUrl                      String?
  namePronunciation               String?
  notes                           String?
  websiteNotes                    String?
  /// The only contact details the receptionist may give a caller. Setup contacts stay private.
  publicPhone                     String?
  publicEmail                     String?
  portalOwnerEmail                String?
  status                          String    @default("lead")
  wizardSubmittedAt               DateTime?
  archivedAt                      DateTime?
  planId                          String?
  plan                            Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  overrideMonthlyPriceCents       Int?
  overrideIncludedMinutes         Int?
  overrideOveragePerMinuteCents   Int?
  overrideSetupFeeCents           Int?
  overrideIncludedChangesPerMonth Int?
  setupFeeWaived                  Boolean   @default(false)
  /// Created through public /signup rather than the admin wizard.
  selfServe                       Boolean   @default(false)
  internal                        Boolean   @default(false)
  coverage                        Json?
  features                        Json?
  voice                           Json?
  phone                           Json?
  compliance                      Json?
  weeklyHours                     Json?
  billingStatus                   String    @default("none")
  stripeCustomerId                String?   @unique
  stripeSubscriptionId            String?   @unique
  stripeCheckoutUrl               String?
  stripeCheckoutExpiresAt         DateTime?
  paidAt                          DateTime?
  serviceEndsAt                   DateTime?
  retellLlmId                     String?   @unique
  retellAgentId                   String?   @unique
  phoneE164                       String?   @unique
  agentSyncStatus                 String    @default("not_provisioned")
  agentSyncError                  String?
  syncedConfigId                  String?
  liveAt                          DateTime?
  /// Days a call's transcript, recording, and caller number are kept before the nightly purge. 7–365.
  callRetentionDays               Int       @default(90)
  lastCallPurgeAt                 DateTime?
  lastCallPurgeCount              Int?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt
  users                           User[]
  invites                         Invite[]
  wizardDraft                     WizardDraft?
  knowledgeBases                  KnowledgeBase[]
  knowledgeDocuments              KnowledgeDocument[]
  changeLogs                      ChangeLog[]
  agentConfigs                    AgentConfig[]
  quickUpdates                    QuickUpdate[]
  changeRequests                  ChangeRequest[]
  transferTargets                 TransferTarget[]
  messages                        ClientMessage[]
  callRecords                     CallRecord[]
  usageRecords                    UsageRecord[]
  provisioningRuns                ProvisioningRun[]
  leads                           Lead[]
  interviewSessions               InterviewSession[]

  @@index([status])
  @@index([archivedAt])
  @@map("client")
}

/// Chat-style AI onboarding interview that fills WizardDraft.payload. Feature off when TEXT_API_KEY is unset.
model InterviewSession {
  id         String    @id @default(cuid())
  clientId   String?
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  draftId    String?
  industry   String
  state      Json
  status     String
  model      String
  tokensIn   Int       @default(0)
  tokensOut  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  @@index([clientId, createdAt])
  @@index([status, createdAt])
  @@map("interview_session")
}

model WizardDraft {
  id          String    @id @default(cuid())
  clientId    String    @unique
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  currentStep Int       @default(1)
  payload     Json
  createdById String
  discardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("wizard_draft")
}

model KnowledgeBase {
  id        String              @id @default(cuid())
  clientId  String
  client    Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  version   Int
  status    String
  hours     Json?
  services  Json?
  faqs      Json?
  policies  Json?
  /// Legacy plaintext staff notes. New writes use staffCipher and leave this null.
  staff     Json?
  /// Encrypted JSON of the staff notes (AES-256-GCM, @alinstra/crypto).
  staffCipher String? @db.Text
  notices   Json?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  documents KnowledgeDocument[]
  agentConfigs AgentConfig[]

  @@unique([clientId, version])
  @@index([clientId])
  @@map("knowledge_base")
}

model KnowledgeDocument {
  id                     String         @id @default(cuid())
  clientId               String
  client                 Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  knowledgeBaseId        String
  knowledgeBase          KnowledgeBase  @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  storageKey             String
  originalFilename       String
  contentType            String
  byteSize               Int
  /// Legacy plaintext. New extractions write extractedTextCipher and leave this null.
  extractedText          String?        @db.Text
  extractedTextCipher    String?        @db.Text
  extractedTextTruncated Boolean        @default(false)
  extractionStatus       String         @default("pending")
  extractionError        String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([clientId])
  @@index([knowledgeBaseId])
  @@map("knowledge_document")
}

/// clientId is null only for catalog edits (plan prices).
model ChangeLog {
  id                  String   @id @default(cuid())
  clientId            String?
  client              Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actorUserId         String
  actorRole           String
  action              String
  entityType          String
  entityId            String
  summary             String
  before              Json?
  after               Json?
  impersonating       Boolean  @default(false)
  impersonatedUserId  String?
  createdAt           DateTime @default(now())

  @@index([clientId, createdAt])
  @@map("change_log")
}

/// Read-access audit log (Phase S part 2): who opened transcripts, recordings, messages, documents.
/// Ids, counts, and request metadata only; never plaintext call or message content. No foreign keys on
/// purpose: rows outlive a removed client or user until the 400-day purge, so breach assessment still works.
model AccessLog {
  id            String   @id @default(cuid())
  at            DateTime @default(now())
  actorUserId   String
  actorRole     String
  clientId      String
  action        String
  entityType    String
  entityId      String
  ip            String?
  userAgent     String?
  impersonating Boolean  @default(false)
  /// List views write one row with the number of items shown.
  count         Int?

  @@index([clientId, at])
  @@index([actorUserId, at])
  @@index([at])
  @@map("access_log")
}

/// Sign-in attempts (Phase S part 3): feeds new-network alerts and lockout forensics. Ids, a normalized
/// email, the client IP and its network prefix, and a truncated user agent; never a password. No foreign
/// keys so rows survive a removed user until the 180-day purge.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  /// Trimmed and lowercased.
  email     String
  at        DateTime @default(now())
  success   Boolean
  ip        String?
  /// /24 for IPv4, /48 for IPv6, e.g. 203.0.113.0/24.
  ipPrefix  String?
  userAgent String?

  @@index([userId, success, at])
  @@index([email, at])
  @@index([at])
  @@map("login_event")
}

/// Custom invite. Not Better Auth's organization plugin.
model Invite {
  id          String    @id @default(cuid())
  email       String
  role        String
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  tokenHash   String    @unique
  tokenCipher String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  emailSentAt DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  @@index([clientId])
  @@index([email])
  @@map("invite")
}

model AgentConfig {
  id               String         @id @default(cuid())
  clientId         String
  client           Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  version          Int
  status           String
  promptText       String         @db.Text
  promptTruncated  Boolean        @default(false)
  templateId       String
  templateVersion  String
  referenceToken   String?
  knowledgeBaseId  String?
  knowledgeBase    KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  knowledgeVersion Int?
  documentIds      Json
  voice            Json?
  greeting         String?
  tools            Json
  settings         Json
  platformAgentId  String?
  source           String
  createdById      String
  createdAt        DateTime       @default(now())

  @@unique([clientId, version])
  @@index([clientId, status])
  @@map("agent_config")
}

model QuickUpdate {
  id            String    @id @default(cuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind          String
  payload       Json
  status        String
  holdReason    String?
  agentConfigId String?
  createdById   String
  reviewedById  String?
  createdAt     DateTime  @default(now())
  reviewedAt    DateTime?

  @@index([clientId, status])
  @@map("quick_update")
}

model ChangeRequest {
  id            String    @id @default(cuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category      String
  description   String    @db.Text
  status        String
  feeCents      Int?
  agentConfigId String?
  createdById   String
  reviewedById  String?
  createdAt     DateTime  @default(now())
  reviewedAt    DateTime?

  @@index([clientId, status])
  @@map("change_request")
}

model TransferTarget {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label     String
  /// Legacy plaintext. New writes use e164Cipher + e164Masked and leave this null.
  e164       String?
  e164Cipher String?  @db.Text
  /// e.g. (423) ***-0198, safe to show in lists.
  e164Masked String?
  createdAt DateTime @default(now())

  @@index([clientId])
  @@map("transfer_target")
}

model ClientMessage {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Legacy plaintext columns, nullable since Phase S. New messages write the *Cipher columns only.
  callerName     String?
  callbackNumber String?
  body           String?  @db.Text
  callerNameCipher     String? @db.Text
  callbackNumberCipher String? @db.Text
  bodyCipher           String? @db.Text
  /// e.g. (423) ***-0198, safe to show in lists.
  callbackMasked       String?
  /// The Retell call the message was taken on, when the tool call carried one.
  retellCallId   String?
  createdAt      DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([retellCallId])
  @@map("client_message")
}

/// One row per Retell call. Transcript, summary, caller number, and the raw webhook events are stored
/// encrypted (AES-256-GCM via @alinstra/crypto) and nulled by the retention purge. Duration, outcome,
/// sentiment, and cost survive the purge for reporting.
model CallRecord {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  retellCallId    String    @unique
  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  callerMasked    String
  endReason       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  /// Encrypted JSON `{ version, text, turns[] }`; turns keep roles, timestamps, and tool invocations.
  transcriptCipher     String?   @db.Text
  /// Encrypted call_analysis.call_summary.
  summaryCipher        String?   @db.Text
  /// Encrypted JSON of every webhook event received for the call, for the admin raw view.
  rawEventsCipher      String?   @db.Text
  /// Encrypted full caller number. `callerMasked` stays for staff display.
  callerE164Cipher     String?
  /// call_analysis.user_sentiment: Positive | Neutral | Negative | Unknown.
  sentiment            String?
  successful           Boolean?
  inVoicemail          Boolean?
  /// call_cost.combined_cost, rounded to whole cents.
  costCents            Int?
  /// R2 object key under clients/<clientId>/calls/. Never a provider URL.
  recordingKey         String?
  /// none | pending | stored | failed | purged
  recordingStatus      String    @default("none")
  recordingError       String?
  recordingContentType String?
  recordingBytes       Int?
  /// message_taken | transferred | booked | no_action | hung_up, derived from the tool calls in the turns.
  outcome              String?
  /// JSON CallFlag[] derived from transcript/analysis (long_silence, short_hangup, tool_error, negative_sentiment).
  flags                Json?
  analyzedAt           DateTime?
  purgedAt             DateTime?
  usageRecord          UsageRecord?

  @@index([clientId, createdAt])
  @@index([clientId, startedAt(sort: Desc)])
  @@index([clientId, outcome])
  @@map("call_record")
}

/// One row per ended call for billing and reports. No caller data or content. Survives retention purge.
model UsageRecord {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  callRecordId    String    @unique
  callRecord      CallRecord @relation(fields: [callRecordId], references: [id], onDelete: Cascade)
  retellCallId    String    @unique
  startedAt       DateTime
  endedAt         DateTime
  durationSeconds Int
  billableMinutes Int
  /// Retell call_cost.combined_cost, rounded to whole cents.
  costCents       Int?
  /// Copied from Client.internal at write time; internal clients are never metered.
  internal        Boolean
  meterReportedAt DateTime?
  meterEventId    String?
  createdAt       DateTime  @default(now())

  @@index([clientId, startedAt])
  @@index([clientId, meterReportedAt])
  @@map("usage_record")
}

model ProvisioningRun {
  id          String             @id @default(cuid())
  clientId    String
  client      Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind        String
  status      String
  createdById String
  createdAt   DateTime           @default(now())
  finishedAt  DateTime?
  /// Set when an admin confirms the number purchase. `retell_number` waits for it.
  numberApprovedAt DateTime?
  steps       ProvisioningStep[]

  @@index([clientId, createdAt])
  @@map("provisioning_run")
}

model ProvisioningStep {
  id         String          @id @default(cuid())
  runId      String
  run        ProvisioningRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  name       String
  status     String
  externalId String?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?

  @@unique([runId, name])
  @@map("provisioning_step")
}

/// Processed Stripe webhook ids. A duplicate event id is ignored.
model StripeEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  type      String
  createdAt DateTime @default(now())

  @@map("stripe_event")
}

/// Stripe Price ids created from the plan catalog. `metered_overage` is reserved for Phase 6.
model StripePrice {
  id            String   @id @default(cuid())
  lookupKey     String   @unique
  stripePriceId String
  planCode      String
  kind          String
  amountCents   Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([planCode, kind])
  @@map("stripe_price")
}

/// Platform-wide key/value settings. Interview text API key stays env-only; DB can override base/model/budget.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("app_setting")
}

/// Marketing /start submissions. No auto-reply to the lead; admin is notified by email.
model Lead {
  id                String    @id @default(cuid())
  business          String
  name              String
  phone             String
  email             String
  industry          String
  missedCalls       String
  notes             String?   @db.Text
  source            String    @default("marketing")
  /// Plan code from /start?plan= (solo|starter|professional|premium|enterprise), when present.
  planInterest      String?
  createdAt         DateTime  @default(now())
  contactedAt       DateTime?
  convertedClientId String?
  convertedClient   Client?   @relation(fields: [convertedClientId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("lead")
}
