{
  "name": "@alinstra/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./founding": "./src/founding.ts",
    "./domain": "./src/domain.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "lint": "pnpm -w exec eslint packages/db/src packages/db/scripts packages/db/prisma.config.ts",
    "encrypt:backfill": "tsx scripts/encrypt-backfill.ts",
    "encrypt:rotate": "tsx scripts/rotate-encryption-key.ts",
    "usage:backfill": "tsx scripts/usage-backfill.ts",
    "stripe:sync": "tsx scripts/stripe-sync.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "prisma generate"
  },
  "dependencies": {
    "@alinstra/agent": "workspace:*",
    "@alinstra/config": "workspace:*",
    "@alinstra/crypto": "workspace:*",
    "@alinstra/email": "workspace:*",
    "@alinstra/providers": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "17.2.3",
    "pg": "8.16.3",
    "tsx": "4.20.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@alinstra/tsconfig": "workspace:*",
    "@types/node": "22.19.1",
    "@types/pg": "8.15.5",
    "prisma": "7.10.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
