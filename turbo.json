{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "src/generated/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@alinstra/auth#test": {
      "dependsOn": ["^build", "@alinstra/db#test"]
    },
    "@alinstra/worker#test": {
      "dependsOn": ["^build", "@alinstra/db#test"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
